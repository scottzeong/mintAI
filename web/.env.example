# RLS 정책이 준다 (supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠ service_role 키는 여기에 절대 넣지 않는다. RLS 를 통째로 우회한다.
#    Edge Function 쪽에만 둔다 (supabase secrets set).
